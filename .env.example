# ── Aplikasi ─────────────────────────────────────────────────
APP_NAME="Normi Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
MARKETING_URL=http://localhost
NORMCHAT_APP_URL=http://localhost
NORMCHAT_MARKETING_PATH=/normchat
# Email kontak di landing marketing; kosong = bagian Kontak disembunyikan.
NORMCHAT_CONTACT_EMAIL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=normchat
DB_USERNAME=normchat
DB_PASSWORD=secret

# ── Sesi ─────────────────────────────────────────────────────
# Sesi habis setelah NORMCHAT_SESSION_IDLE_DAYS hari tanpa aksi user; SESSION_LIFETIME (menit)
# otomatis dibuat tidak lebih pendek dari batas itu. SESSION_SECURE_COOKIE=true bila memakai HTTPS.
SESSION_DRIVER=redis
SESSION_LIFETIME=7200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
NORMCHAT_SESSION_IDLE_DAYS=5

# ── Antrean, cache, realtime ─────────────────────────────────
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default

REVERB_APP_ID=normchat
REVERB_APP_KEY=normchat-key
REVERB_APP_SECRET=normchat-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Penyimpanan file ─────────────────────────────────────────
# NORMCHAT_STORAGE=s3: lampiran, export, backup, dan avatar di bucket AWS_BUCKET (folder
# attachments/, exports/, backups/, avatars/); ukuran & isi file kecil di-cache di Redis.
# NORMCHAT_STORAGE=local: di NORMCHAT_STORAGE_ROOT (pengembangan lokal).
# File lama di server dipindah ke S3 dengan: php artisan normchat:files-to-s3 --delete-local
NORMCHAT_STORAGE=local
NORMCHAT_STORAGE_ROOT=/opt/normchat/storage
FILESYSTEM_DISK=normchat_attachments

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Login Google (aktif) ─────────────────────────────────────
# Redirect URI yang didaftarkan di Google Cloud: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Pembayaran ───────────────────────────────────────────────
# Payment Notification URL di dashboard Midtrans: ${APP_URL}/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Interdotz (dinonaktifkan sementara; kode tetap ada) ──────
NORMCHAT_INTERDOTZ_ENABLED=false
INTERDOTZ_CLIENT_ID=
INTERDOTZ_CLIENT_SECRET=
INTERDOTZ_ADMIN_BEARER_TOKEN=
INTERDOTZ_API_BASE=https://api-interdotz.technocrats.studio
INTERDOTZ_SSO_BASE=https://interdotz.technocrats.studio
INTERDOTZ_REDIRECT_URI="${APP_URL}/sso/interdotz/callback"

NORMCHAT_WEBHOOK_SECRET=
NORMCHAT_ALLOW_INTERDOTZ_BEARER_ONLY=true

# ── Normi Chat ───────────────────────────────────────────────
# Pisahkan dengan koma. Akses panel /superadmin; juga penerima email peringatan biaya OpenAI.
NORMCHAT_SUPERADMIN_EMAILS=superadmin@interdotz.com
# Kurs cadangan USD→IDR, hanya dipakai sampai superadmin mengisi kurs harian di /superadmin.
NORMCHAT_USD_TO_IDR=17950
NORMCHAT_PRODUCT_LOGO_URL="${APP_URL}/normchat-logo.png"
NORMCHAT_PRODUCT_ICON_URL="${APP_URL}/icons/icon-192.png"

# ── AI (OpenAI) ──────────────────────────────────────────────
# Model dipilih dari katalog /superadmin, bukan dari .env. Satu key untuk semua grup.
OPENAI_API_KEY=
# Admin key (sk-admin-...) + project ID: hanya untuk membaca biaya nyata saat rekonsiliasi harian.
# Kosong = rekonsiliasi dilewati.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=

# ── Email ────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
